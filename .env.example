# Local demo works without copying this file.
APP_ENV=development
DATABASE_URL=sqlite:///./data/waste.db
UPLOAD_DIR=data/evidence
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
# Production: APP_ENV=production, HTTPS, PostgreSQL and exact public origin.
# DATABASE_URL=postgresql+psycopg://swm:YOUR_PASSWORD@localhost:5432/swm
# Optional email: defaults to unconfigured; in-app delivery always works.
EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SLA_WARNING_HOURS=2
ESCALATE_AFTER_HOURS=24
